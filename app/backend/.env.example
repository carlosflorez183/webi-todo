# Copiar a .env y ajustar. No versionar .env con credenciales reales.

# Usuario de APLICACIÓN (readWrite sobre la base). Nunca usar root aquí.
MONGODB_URI=mongodb://webi_app:cambia_esta_contraseña@localhost:27017/webi-todo?authSource=webi-todo
MONGO_DATABASE=webi-todo

# Root: solo para docker-compose (creación del contenedor y del usuario de app).
MONGO_ROOT_USERNAME=webi_admin
MONGO_ROOT_PASSWORD=cambia_esta_contraseña

# Contraseña del usuario de aplicación (la usa mongo-init al crearlo).
MONGO_APP_PASSWORD=cambia_esta_contraseña

# Cognito (validación del access token). Valores públicos del User Pool.
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_REGION=us-east-1
COGNITO_CLIENT_ID=tu_client_id
