{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch --import tsx src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f mongo",
    "db:ps": "docker compose ps",
    "db:reset": "docker compose down -v"
  },
  "dependencies": {
    "express": "^5",
    "jose": "^6.2.17",
    "mongoose": "^9.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5",
    "@types/node": "^24",
    "tsx": "^4",
    "typescript": "~6.0.3"
  }
}
